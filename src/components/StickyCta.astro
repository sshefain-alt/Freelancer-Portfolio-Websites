---
import type { Site } from '../data/types';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const base = `/${site.prefix}`;
---

{
  site.phone && (
    <div class="sticky-cta">
      <a class="btn btn--ghost" href={`tel:${site.phone}`}>
        Call now
      </a>
      <a class="btn btn--primary" href={`${base}/contact/`}>
        Contact
      </a>
    </div>
  )
}
{
  !site.phone && (
    <div class="sticky-cta">
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>
        Email
      </a>
      <a class="btn btn--primary" href={`${base}/contact/`}>
        Contact
      </a>
    </div>
  )
}
