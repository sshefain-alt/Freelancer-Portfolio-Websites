---
import Ph from './Ph.astro';
import type { Project, Site } from '../data/types';

interface Props {
  project: Project;
  site: Site;
  motif?: 'web' | 'photo' | 'video' | 'architecture' | 'abstract';
}

const { project, site, motif = 'abstract' } = Astro.props;
const href = `/${site.prefix}/project/${project.slug}/`;
---

<article class="card">
  <div class="card__media">
    <Ph
      src={project.cover}
      alt={`${project.title} — ${project.tag} project by ${site.brand}`}
      motif={motif}
      accent={site.accent}
      sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"
    />
  </div>
  <div class="card__body">
    <span class="tag">{project.tag}</span>
    <h3 class="card__title"><a href={href}>{project.title}</a></h3>
    <p class="card__excerpt">{project.excerpt}</p>
    <div class="card__meta">
      <span>{project.client ?? site.brand}</span>
      <span>{project.year}</span>
    </div>
  </div>
</article>
