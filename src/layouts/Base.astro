---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { seoTitle } from '../lib/seo';
import type { Site } from '../data/types';

interface Props {
  site: Site;
  title: string;
  description: string;
  /** Path without trailing slash, e.g. "/projects" or "/project/some-slug" */
  path: string;
  /** JSON-LD structured data (stringified) */
  jsonld?: object[];
  image?: string;
  type?: 'website' | 'article';
}

const { site, title, description, path, jsonld = [], image, type = 'website' } = Astro.props;

const canonical = new URL(path === '/' ? '/' : `${path.replace(/\/$/, '')}/`, Astro.site).href;
// Fit within search engines' display limit; brand is appended only if the
// caller has not already included it.
const fullTitle = title.includes(site.brand) ? seoTitle([title]) : seoTitle([title, site.brand]);
const ogImage = image
  ? new URL(image, Astro.site).href
  : new URL('/og-default.png', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: new URL(`/${site.prefix}/`, Astro.site).href,
  email: `mailto:${site.email}`,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
  },
  worksFor: {
    '@type': 'Organization',
    name: site.brand,
    url: new URL(`/${site.prefix}/`, Astro.site).href,
  },
  sameAs: site.socials.map((s) => s.href),
  knowsAbout: site.skills,
};

const breadcrumbPath = path.split('/').filter(Boolean);
const crumbs = [{ name: 'Home', url: '/' }, ...breadcrumbPath.map((seg, i) => ({
  name: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
  url: `/${breadcrumbPath.slice(0, i + 1).join('/')}/`,
}))];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.url === '/' ? `/${site.prefix}/` : `${c.url}`, Astro.site).href,
  })),
};

const schemas = [personSchema, breadcrumbSchema, ...jsonld];

// Astro does not interpolate expressions inside <style> blocks, so the theme
// is assembled here and injected as raw CSS. Applied before first paint to
// avoid a flash of unbranded colour.
// `:root:root` (0,2,0) deliberately outranks the `:root` (0,1,0) defaults in
// global.css, so each profile's palette always wins.
const displayStack =
  site.display === 'serif'
    ? `'Iowan Old Style','Palatino Linotype',Palatino,'Book Antiqua',Georgia,'Times New Roman',serif`
    : `ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif`;

const themeCss = `:root:root{--accent:${site.accent};--accent-dark:${site.accentDark};--tint:${site.tint}}
body[data-display='${site.display}']{--display:${displayStack}}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={site.accent} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand} — ${site.role} in ${site.city}`} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="generator" content={Astro.generator} />

    <style is:inline set:html={themeCss}></style>

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>
      // Mark JS as available — used only to enhance, never to reveal content.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-display={site.display} data-kind={site.kind}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav site={site} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    <StickyCta site={site} />

    <script>
      // Mobile navigation — progressive enhancement.
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
      if (toggle && drawer) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          drawer.classList.toggle('is-open', open);
        };
        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
        );
        drawer.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>
  </body>
</html>
